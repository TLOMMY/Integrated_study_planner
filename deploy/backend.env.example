# 生产环境配置模板。复制到 /etc/xueyeguanjia/backend.env 后修改，权限设为 600。
# 不要把真实的 backend.env 提交到仓库。

# 必改：随机长字符串，可用 `openssl rand -base64 48` 生成。泄露后任何人都能伪造登录凭证。
JWT_SECRET_KEY=请替换为随机长字符串
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库放在仓库目录之外，方便升级与备份
DATABASE_URL=sqlite:////var/lib/xueyeguanjia/study_planner.db

# 允许访问接口的页面来源：网页版 + 安卓 / iOS App 外壳
CORS_ORIGINS=https://app.xueyeguanjia.com,https://localhost,http://localhost,capacitor://localhost

# 服务器默认 AI 模型（可选）；用户也可以在 AI 设置里填自己的 Key
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 公网部署必须为 0：禁止用户把模型地址填成服务器内网，防止被当作跳板
AI_ALLOW_PRIVATE_URLS=0

# 正式环境建议关闭演示账号与演示同学
SEED_DEMO=0

# 用户反馈 txt 的保存目录；ADMIN_EMAILS 里的账号可在线查看反馈
FEEDBACK_DIR=/var/lib/xueyeguanjia/feedback
ADMIN_EMAILS=

# 网站对外地址（通知里的后台链接），install.sh 会按部署模式自动填写
APP_PUBLIC_URL=

# 新反馈 / 运维告警通知（也可以在管理后台「设置」里填写，后台的值优先）：
# 群机器人地址（企业微信 / 飞书 / 钉钉自动识别）、加签密钥、通知邮箱（逗号分隔）
FEEDBACK_WEBHOOK=
FEEDBACK_WEBHOOK_SECRET=
FEEDBACK_NOTIFY_EMAILS=

# 服务器 DeepSeek Key 的每人每日 AI 额度（0 = 不限；管理后台「设置」里改的值优先）。用户自己的 Key、管理员不受限
AI_DAILY_CALLS=30
AI_DAILY_TOKENS=500000

# 备案号：为空时页面不显示。ICP 备案号链接到 beian.miit.gov.cn，公安备案号链接到 beian.mps.gov.cn
ICP_NUMBER=
POLICE_BEIAN=
# 隐私政策 / 用户协议里的联系邮箱
CONTACT_EMAIL=

# 错误激增告警：ALERT_WINDOW_MINUTES 分钟内后端 5xx ≥ ALERT_5XX 或前端错误 ≥ ALERT_CLIENT_ERRORS 时告警，
# 同类告警 ALERT_COOLDOWN_MINUTES 分钟内只发一次；阈值设 0 关闭
ALERT_WINDOW_MINUTES=5
ALERT_5XX=10
ALERT_CLIENT_ERRORS=30
ALERT_COOLDOWN_MINUTES=30
