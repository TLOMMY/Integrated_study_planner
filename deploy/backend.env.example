# 生产环境配置模板。复制到 /etc/xueyeguanjia/backend.env 后修改，权限设为 600。
# 不要把真实的 backend.env 提交到仓库。

# 必改：随机长字符串，可用 `openssl rand -base64 48` 生成。泄露后任何人都能伪造登录凭证。
JWT_SECRET_KEY=请替换为随机长字符串
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库放在仓库目录之外，方便升级与备份
DATABASE_URL=sqlite:////var/lib/xueyeguanjia/study_planner.db

# 允许访问接口的页面来源：网页版 + 安卓 / iOS App 外壳
CORS_ORIGINS=https://app.xueyeguanjia.com,https://localhost,http://localhost,capacitor://localhost

# 服务器默认 AI 模型（可选）；用户也可以在 AI 设置里填自己的 Key
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 公网部署必须为 0：禁止用户把模型地址填成服务器内网，防止被当作跳板
AI_ALLOW_PRIVATE_URLS=0

# 正式环境建议关闭演示账号与演示同学
SEED_DEMO=0

# 用户反馈 txt 的保存目录；ADMIN_EMAILS 里的账号可在线查看反馈
FEEDBACK_DIR=/var/lib/xueyeguanjia/feedback
ADMIN_EMAILS=
